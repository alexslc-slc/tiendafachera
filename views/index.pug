
extends layout

block content

  // Encabezado
  div(class='flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6')
    div
      h1(class='text-2xl sm:text-3xl font-bold text-white') Catálogo de Productos
      p(class='text-sm text-gray-400 mt-1') Gestione sus inventarios en tiempo real.

    button#btnAbrirNuevoMain(
      class='w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-3 rounded-lg shadow-lg transition duration-200 inline-flex items-center justify-center gap-2 cursor-pointer'
    )
      svg(class='w-5 h-5', fill='none', stroke='currentColor', viewBox='0 0 24 24')
        path(stroke-linecap='round', stroke-linejoin='round', stroke-width='2', d='M12 4v16m8-8H4')
      span Nuevo Producto

  // TABLA PARA ESCRITORIO
  div(class='hidden sm:block bg-gray-800 rounded-xl shadow-xl overflow-hidden border border-gray-700')
    div(class='overflow-x-auto')
      table(class='w-full text-left border-collapse')
        thead(class='bg-gray-700 text-gray-300 uppercase text-xs tracking-wider')
          tr
            th(class='py-4 px-6') ID
            th(class='py-4 px-6') Nombre
            th(class='py-4 px-6') Precio
            th(class='py-4 px-6 text-right') Acciones

        tbody(class='divide-y divide-gray-700 text-gray-200')
          if productos.length > 0
            each producto in productos
              tr(class='hover:bg-gray-700 transition')
                td(class='py-4 px-6 font-mono text-sm text-gray-400') ##{producto.id}

                td(class='py-4 px-6 font-medium text-white') #{producto.nombre}

                td(class='py-4 px-6 text-emerald-400 font-semibold') S/ #{Number(producto.precio).toFixed(2)}

                td(class='py-4 px-6 text-right')
                  div(class='flex justify-end gap-2')
                    button(
                      class='btn-editar inline-flex items-center px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-medium rounded-md transition cursor-pointer',
                      data-id=producto.id,
                      data-nombre=producto.nombre,
                      data-precio=producto.precio
                    ) Editar

                    a(
                      href=`/eliminar/${producto.id}`,
                      class='inline-flex items-center px-3 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium rounded-md transition',
                      onclick="return confirm('¿Seguro de eliminar este producto?')"
                    ) Eliminar

          else
            tr
              td(class='py-8 px-6 text-center text-gray-500', colspan='4') No hay productos registrados aún.

  // TARJETAS PARA MÓVILES
  div(class='sm:hidden space-y-3')
    if productos.length > 0
      each producto in productos
        div(class='bg-gray-800 rounded-xl border border-gray-700 p-4 shadow-lg')
          div(class='flex items-start justify-between gap-3')
            div(class='min-w-0')
              p(class='text-xs text-gray-500 font-mono mb-1') ##{producto.id}
              h3(class='text-base font-semibold text-white break-words') #{producto.nombre}

            span(class='text-emerald-400 font-bold text-base whitespace-nowrap') S/ #{Number(producto.precio).toFixed(2)}

          div(class='flex gap-2 mt-4 pt-3 border-t border-gray-700')
            button(
              class='btn-editar flex-1 px-3 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg transition cursor-pointer',
              data-id=producto.id,
              data-nombre=producto.nombre,
              data-precio=producto.precio
            ) Editar

            a(
              href=`/eliminar/${producto.id}`,
              class='flex-1 text-center px-3 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium rounded-lg transition',
              onclick="return confirm('¿Seguro de eliminar este producto?')"
            ) Eliminar
    else
      div(class='bg-gray-800 rounded-xl border border-gray-700 p-8 text-center text-gray-500')
        | No hay productos registrados aún.

  // FONDO DEL DRAWER
  #drawerBackdrop(
    class='fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out'
  )

  // DRAWER
  #drawerPanel(
    class='fixed top-0 right-0 z-50 h-full w-full sm:max-w-md bg-gray-800 border-l border-gray-700 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-4 sm:p-6 overflow-y-auto'
  )

    div(class='flex items-center justify-between gap-3 pb-4 border-b border-gray-700 mb-6')
      h2#drawerTitle(class='text-lg sm:text-xl font-bold text-white') Formulario Producto

      button#btnCerrarDrawer(
        type='button'
        aria-label='Cerrar formulario'
        class='text-gray-400 hover:text-white p-2 rounded-lg hover:bg-gray-700 transition cursor-pointer'
      )
        svg(class='w-6 h-6', fill='none', stroke='currentColor', viewBox='0 0 24 24')
          path(stroke-linecap='round', stroke-linejoin='round', stroke-width='2', d='M6 18L18 6M6 6l12 12')

    form#drawerForm(
      method='POST'
      action='/nuevo'
      class='space-y-5 flex-1 flex flex-col justify-between gap-6'
    )

      div(class='space-y-5')
        div
          label(for='drawerNombre', class='block text-sm font-medium text-gray-300 mb-2') Nombre del Producto

          input#drawerNombre(
            type='text'
            name='nombre'
            required
            class='w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent'
          )

        div
          label(for='drawerPrecio', class='block text-sm font-medium text-gray-300 mb-2') Precio (S/)

          div(class='relative')
            div(class='absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none')
              span(class='text-gray-400') S/

            input#drawerPrecio(
              type='number'
              step='0.01'
              min='0'
              name='precio'
              required
              class='w-full bg-gray-900 border border-gray-600 rounded-lg pl-10 pr-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent'
            )

      div(class='flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-4 border-t border-gray-700')
        button#btnCancelarDrawer(
          type='button'
          class='w-full sm:w-auto px-4 py-3 bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-medium rounded-lg transition cursor-pointer'
        ) Cancelar

        button(
          type='submit'
          class='w-full sm:w-auto px-4 py-3 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg shadow-md transition cursor-pointer'
        ) Guardar

block scripts
  script.
    const backdrop = document.getElementById('drawerBackdrop');
    const panel = document.getElementById('drawerPanel');
    const form = document.getElementById('drawerForm');
    const title = document.getElementById('drawerTitle');
    const inputNombre = document.getElementById('drawerNombre');
    const inputPrecio = document.getElementById('drawerPrecio');

    function openDrawer(isEdit = false, data = {}) {
      if (isEdit) {
        title.textContent = 'Editar Producto';
        form.action = `/actualizar/${data.id}`;
        inputNombre.value = data.nombre;
        inputPrecio.value = data.precio;
      } else {
        title.textContent = 'Nuevo Producto';
        form.action = '/nuevo';
        form.reset();
      }

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');

      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');

      inputNombre.focus();
    }

    function closeDrawer() {
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');

      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
    }

    document.getElementById('btnAbrirNuevo')?.addEventListener('click', () => openDrawer(false));

    document.getElementById('btnAbrirNuevoMain')?.addEventListener('click', () => openDrawer(false));

    document.querySelectorAll('.btn-editar').forEach(btn => {
      btn.addEventListener('click', () => {
        openDrawer(true, {
          id: btn.dataset.id,
          nombre: btn.dataset.nombre,
          precio: btn.dataset.precio
        });
      });
    });

    document.getElementById('btnCerrarDrawer').addEventListener('click', closeDrawer);

    document.getElementById('btnCancelarDrawer').addEventListener('click', closeDrawer);

    backdrop.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeDrawer();
      }
    });
