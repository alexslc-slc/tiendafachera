doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title StoreFachera
    script(src='https://cdn.tailwindcss.com')

  body(class='bg-gray-900 text-gray-100 min-h-screen flex flex-col relative overflow-x-hidden')

    header(class='bg-gray-800 border-b border-gray-700 sticky top-0 z-40')
      div(class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8')
        div(class='flex items-center justify-between gap-3 min-h-16 py-3')

          // Logo
          a(href='/', class='flex items-center gap-2 min-w-0')
            div(class='bg-indigo-600 p-2 rounded-lg shrink-0')
              svg(class='w-6 h-6 text-white', fill='none', stroke='currentColor', viewBox='0 0 24 24')
                path(stroke-linecap='round', stroke-linejoin='round', stroke-width='2', d='M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4')
            span(class='font-bold text-lg sm:text-xl tracking-tight text-white truncate') StoreFachera

          // Navegación
          nav(class='flex items-center gap-2 shrink-0')
            a(
              href='/'
              class='text-gray-300 hover:bg-gray-700 hover:text-white px-2 sm:px-3 py-2 rounded-md text-sm font-medium'
            ) Productos

            button#btnAbrirNuevo(
              class='bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-md text-sm font-medium transition cursor-pointer whitespace-nowrap'
            )
              span(class='sm:hidden') + Nuevo
              span(class='hidden sm:inline') + Nuevo Producto

    main(class='flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8')
      block content

    footer(class='bg-gray-800 border-t border-gray-700 mt-auto')
      div(class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5')
        div(class='flex flex-col sm:flex-row items-center justify-between gap-3')
          p(class='text-sm text-gray-400 text-center sm:text-left') © facherando ando
          span(class='text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded') Pug 🐶 xd

    block scripts
