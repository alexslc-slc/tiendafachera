extends layout

block content
  div(class='max-w-md mx-auto')
    div(class='bg-gray-800 rounded-xl shadow-xl border border-gray-700 p-6')
      h2(class='text-xl font-bold text-white mb-6 border-b border-gray-700 pb-3') #{titulo}
      
      form(method='POST', action=accion, class='space-y-5')
        div
          label(for='nombre', class='block text-sm font-medium text-gray-300 mb-2') Nombre del Producto
          input#nombre(
            type='text',
            name='nombre',
            value=producto.nombre || '',
            required,
            class='w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent'
          )

        div
          label(for='precio', class='block text-sm font-medium text-gray-300 mb-2') Precio (S/)
          div(class='relative')
            div(class='absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none')
              span(class='text-gray-400') S/
            input#precio(
              type='number',
              step='0.01',
              min='0',
              name='precio',
              value=producto.precio || '',
              required,
              class='w-full bg-gray-900 border border-gray-600 rounded-lg pl-10 pr-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent'
            )

        div(class='flex items-center justify-end space-x-3 pt-4 border-t border-gray-700')
          a(href='/', class='px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-medium rounded-lg transition') Cancelar
          button(type='submit', class='px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg shadow-md transition') Guardar